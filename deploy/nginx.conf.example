# ===== Yetkaz.uz — nginx reverse-proxy + HTTPS namunasi =====
# Domeningizni yozing, SSL sertifikatini (Let's Encrypt / certbot) oling:
#   sudo certbot --nginx -d yetkaz.uz -d www.yetkaz.uz
# Backend 127.0.0.1:5050 da ishlaydi (pm2 yoki Docker orqali).

# HTTP -> HTTPS ga yo'naltirish
server {
    listen 80;
    server_name yetkaz.uz www.yetkaz.uz;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name yetkaz.uz www.yetkaz.uz;

    # certbot avtomat to'ldiradi:
    ssl_certificate     /etc/letsencrypt/live/yetkaz.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yetkaz.uz/privkey.pem;

    # Yuklanadigan rasmlar uchun katta limit (backend 6MB tekshiradi)
    client_max_body_size 10m;

    # Xavfsizlik sarlavhalari (helmet ustiga)
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;

    location / {
        proxy_pass         http://127.0.0.1:5050;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
