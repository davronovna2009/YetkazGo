# Yetkaz.uz backend — muhit o'zgaruvchilari namunasi
# Bu faylni `.env` ga nusxalang va qiymatlarni o'zgartiring (productionda majburiy!)

# Server porti
PORT=5050

# JWT maxfiy kaliti — productionda ALBATTA uzun, tasodifiy qiymatga o'zgartiring!
# Masalan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret

# Token amal qilish muddati
JWT_EXPIRES=7d

# ===== Telegram xabarnoma boti (ixtiyoriy) =====
# @BotFather bergan bot tokeni:
TG_TOKEN=
# Yangi buyurtma xabari boradigan chat/guruh id
# (shaxsiy chat: musbat son; guruh/kanal: -100... ko'rinishida):
TG_CHAT_OPS=

# SQLite bazasi yo'li (ixtiyoriy)
# DB_PATH=./data/yetkaz.db
# Yuklangan rasmlar papkasi (ixtiyoriy)
# UPLOAD_DIR=./uploads
